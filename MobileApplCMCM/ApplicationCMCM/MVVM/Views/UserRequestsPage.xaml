<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ApplicationCMCM.MVVM.ViewModels"
             xmlns:model="clr-namespace:ApplicationCMCM.MVVM.Models"
             x:DataType="viewmodel:UserRequestsPageViewModel"
             x:Class="ApplicationCMCM.MVVM.Views.UserRequestsPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding UserRequests}"
                            HorizontalOptions="Center"
                            Grid.Row="0">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:RequestModel">
                        <Frame Style="{StaticResource CardView}"
                               Margin="10"
                               HeightRequest="150">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="{Binding CategoryName}"
                                       FontSize="Large"
                                       FontAttributes="Bold"
                                       Margin="10,0,0,0"
                                       TextColor="{StaticResource PrimaryDark}" />
                                <HorizontalStackLayout>
                                    <Label Text="Subject: "
                                           FontSize="Large"
                                           FontAttributes="Bold"
                                           Margin="10,0,0,0" />
                                    <Label Text="{Binding Subject}"
                                           FontSize="Medium"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout>
                                    <Label Text="Comment: "
                                           FontSize="Large"
                                           FontAttributes="Bold"
                                           Margin="10,0,0,0" />
                                    <Label Text="{Binding RequestComment}"
                                           FontSize="Medium"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout>
                                    <Label Text="Status: "
                                           FontSize="Large"
                                           FontAttributes="Bold"
                                           Margin="10,0,0,0" />
                                    <Label Text="Submitted"
                                           FontSize="Medium"
                                           VerticalOptions="Center"
                                           TextColor="Green" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button x:Name="BtnRegister"
                Text="Back"
                HeightRequest="50"
                FontSize="Medium"
                Command="{Binding BackToMainMenuCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Style="{StaticResource ButtonOutline}"
                Margin="20"
                Grid.Row="1" />
    </Grid>
</ContentPage>