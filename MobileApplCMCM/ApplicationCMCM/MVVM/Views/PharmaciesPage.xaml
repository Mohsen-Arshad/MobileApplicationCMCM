<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:ApplicationCMCM.MVVM.ViewModels"
             xmlns:model="clr-namespace:ApplicationCMCM.MVVM.Models"
             x:DataType="viewmodel:PharmaciesPageViewModel"
             x:Class="ApplicationCMCM.MVVM.Views.PharmaciesPage"
             Title="PharmaciesPage">

    <Grid RowDefinitions="*,Auto">
        <CollectionView ItemsSource="{Binding PharmacyInfo}"
                        HorizontalOptions="Center"
                        Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:PharmacyModel">
                    <Frame Style="{StaticResource CardView}"
                           Margin="10"
                           HeightRequest="150">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding PharmacyName}"
                                   FontSize="Large"
                                   FontAttributes="Bold"
                                   Margin="10,0,0,0"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <HorizontalStackLayout>
                                <Label Text="Phone Number: "
                                       FontSize="Large"
                                       FontAttributes="Bold"
                                       Margin="10,0,0,0" />
                                <Label Text="{Binding PharmacyPhoneNumber}"
                                       FontSize="Medium"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout>
                                <Label Text="Address: "
                                       FontSize="Large"
                                       FontAttributes="Bold"
                                       Margin="10,0,0,0" />
                                <Label Text="{Binding PharmacyAddress}"
                                       FontSize="Medium"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button x:Name="BtnRegister"
                Text="Back"
                HeightRequest="50"
                FontSize="Medium"
                Command="{Binding BackToMainMenuCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Style="{StaticResource ButtonOutline}"
                Margin="20"
                Grid.Row="1" />
    </Grid>
</ContentPage>